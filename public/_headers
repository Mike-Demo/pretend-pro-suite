# Hashed build assets (JS/CSS/fonts) — safe to cache forever, filenames change per build
/assets/*
  cache-control: public, max-age=31536000, immutable

# Install/pin icons and manifest — rarely change, revalidate weekly
/favicon.ico
  cache-control: public, max-age=604800
/favicon.png
  cache-control: public, max-age=604800
/favicon-16.png
  cache-control: public, max-age=604800
/favicon-32.png
  cache-control: public, max-age=604800
/apple-touch-icon.png
  cache-control: public, max-age=604800
/icon-192.png
  cache-control: public, max-age=604800
/icon-512.png
  cache-control: public, max-age=604800
/icon-maskable-512.png
  cache-control: public, max-age=604800
/splash-750x1334.png
  cache-control: public, max-age=604800
/splash-1125x2436.png
  cache-control: public, max-age=604800
/splash-1170x2532.png
  cache-control: public, max-age=604800
/splash-1290x2796.png
  cache-control: public, max-age=604800
/splash-1620x2160.png
  cache-control: public, max-age=604800
/splash-2160x1620.png
  cache-control: public, max-age=604800
/manifest.webmanifest
  cache-control: public, max-age=86400

# Self-hosted webfonts — immutable filenames, safe to cache forever
/fonts/*
  cache-control: public, max-age=31536000, immutable

# Markdown twins — serve as text/markdown so agents get a real markdown body
/index.txt
  content-type: text/markdown; charset=utf-8
/about.txt
  content-type: text/markdown; charset=utf-8
/contact.txt
  content-type: text/markdown; charset=utf-8
/privacy.txt
  content-type: text/markdown; charset=utf-8
/developers.txt
  content-type: text/markdown; charset=utf-8
/auth.txt
  content-type: text/markdown; charset=utf-8
/pricing.txt
  content-type: text/markdown; charset=utf-8

# HTML and everything else — always revalidate so deploys ship instantly
/*
  cache-control: public, max-age=0, must-revalidate
